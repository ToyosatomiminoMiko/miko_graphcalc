// =============================================================
// 向量场的旋度 curl F = ( ∂R/∂y - ∂Q/∂z ,  ∂P/∂z - ∂R/∂x ,  ∂Q/∂x - ∂P/∂y )
//
// 与散度一样,curl 分析在编译期对 vector_field 的三个分量分别求
// 六个一阶偏导,再按上式组合成向量,在测量点处求值:
//     curl r = curl(F) at [px, py, pz];
// 结果打印在右侧"结果"列表,并在测量点画一个黄色圆点;旋度向量非
// 零时按其方向画法向箭矢,为零(无旋场)时只保留测量点.
//
// 本例给出两个对照场:
//   1) F_rot = [-w*y, w*x, 0] -- 绕 z 轴的刚体旋转场
//        curl F_rot = (0, 0, ∂(w*x)/∂x - ∂(-w*y)/∂y) = (0, 0, 2*w)
//      旋度处处指向 +z,大小只与角速度 w 有关(2w),与测量点无关;
//   2) F_grad = [a*x, b*y, c*z] -- 势函数
//        φ = a*x^2/2 + b*y^2/2 + c*z^2/2 的梯度场
//        curl F_grad = (0, 0, 0) -- 保守场必无旋;
//      注意它同时有散度 div = a + b + c ≠ 0(与 divergence_vector_field
//      示例中的 F_lin 是同一个场),说明"无旋"与"无散"是两个独立性质.
//
// 两个场画在同一个盒子里会相互遮挡,建议先在"对象"面板隐藏其一,
// 再拖动滑块对照"结果"面板的向量.
// =============================================================

// 可调参数:旋转角速度 w,梯度场强度 a/b/c,测量点 (px, py, pz)
param w = 1 in [0.2, 4, 0.1];
param a = 1 in [-2, 2, 0.1];
param b = 1 in [-2, 2, 0.1];
param c = 1 in [-2, 2, 0.1];
param px = 1 in [-3, 3, 0.1];
param py = 1 in [-3, 3, 0.1];
param pz = 1 in [-3, 3, 0.1];

// 场 1:刚体旋转场,curl = (0, 0, 2w)
vector_field F_rot = [-w * y, w * x, 0] {
    range = [-4, 4, -4, 4, -4, 4];
    grid = [5, 5, 5];
    scale = 0.9;
};

// 场 2:梯度场(保守场),curl = (0, 0, 0)
vector_field F_grad = [a * x, b * y, c * z] {
    range = [-4, 4, -4, 4, -4, 4];
    grid = [5, 5, 5];
    scale = 0.9;
};

// 旋度分析:两个场在同一个测量点取值
curl r_rot = curl(F_rot) at [px, py, pz];

curl r_grad = curl(F_grad) at [px, py, pz];
