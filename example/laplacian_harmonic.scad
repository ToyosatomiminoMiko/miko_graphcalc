// =============================================================
// 拉普拉斯算子 ∇² 的三类源与"调和场恒为 0"
//
// 拉普拉斯算子是"梯度的散度",对**标量场**逐点给出一个数:
//     ∇²f = ∇·(∇f) = f_xx + f_yy + f_zz
// 满足 ∇²f = 0 的函数叫**调和函数**,它没有"源"也没有"汇";
// 反之 ∇²f > 0 的点像"源",< 0 的点像"汇".
//
// 本例把四类可分析的标量场源放在一起,对照"维度决定哪几项参与":
//   1) curve      y = x^3/3 只有 x 一个自由变量:∇²f = f''(x) = 2x;
//   2) surface    z = x^2 - y^2(双曲抛物面):∇²f = 2 + (-2) = 0,
//                 是调和函数的经典图像,拖动滑块数值恒为 0;
//   3) implicit   f(x,y) = x^2 + y^2 的水平集(半径 R 的圆):
//                 ∇²f = 2 + 2 = 4 处处成立--水平集本身是圆,
//                 但水平集函数并不调和,两者不要混为一谈;
//   4) implicit   三维 x^2 + y^2 + z^2 的水平集(球面):∇²f = 6,
//                 与半径/球心无关(二次型的拉普拉斯是常数).
// 隐式场先沿 ∇f 把 at 投影到等值面,再在投影点取 ∇²f,
// 因此测量点的球坐标会一并回显在"结果"列表的细节行里.
//
// 想先看最简单的"数值怎么算出来"的例子,见
// example/laplacian_scalar_field.scad.
// =============================================================

// 可调参数:三次项系数 a,双曲面的测量点 (px, py)
param a = 1 in [-2, 2, 0.1];
param px = 1 in [-3, 3, 0.1];
param py = 1 in [-3, 3, 0.1];

// 源 1:一元三次曲线 y = a*x^3/3 -> ∇²f = f''(x) = 2*a*x
curve c = a * x^3 / 3 {
    color = "#6dd5ff";
    range = [-3, 3];
    segments = 256;
}

// 源 2:双曲抛物面 z = x^2 - y^2 -> ∇²f = 2 - 2 = 0(调和)
surface saddle = x^2 - y^2 {
    range = [-3, 3, -3, 3];
    segments = 96;
}

// 源 3:二维隐式曲线 x^2 + y^2 - R^2 = 0,即半径 3 的圆
//       -> ∇²f = 2 + 2 = 4(水平集函数不调和)
implicit circle = x^2 + y^2 - 9;

// 源 4:三维隐式球面 x^2 + y^2 + z^2 - 4 = 0
//       -> ∇²f = 2 + 2 + 2 = 6(二次型,处处常数)
implicit sphere_field = x^2 + y^2 + z^2 - 4;

// 四类源的拉普拉斯分析
laplacian Lc = laplacian(c) at [px, 0];
laplacian Ls = laplacian(saddle) at [px, py];
laplacian Li = laplacian(circle) at [px, py];
laplacian Lb = laplacian(sphere_field) at [px, 2, 2];
