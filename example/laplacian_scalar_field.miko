// =============================================================
// 标量场的拉普拉斯算子 ∇²f = f_xx + f_yy + f_zz
//
// 拉普拉斯算子是"梯度的散度":先看 f 往哪边升(∇f),再看这个
// 方向场在一点是发散还是汇聚.它是标量算子,标量场进,标量出:
//     laplacian L = laplacian(s) at [px, py];
// 结果以数字形式打印在右侧"结果"列表,并在源曲面上点一个黄色圆点.
//
// 本例用最简单的曲面 f = a*x^2 + b*y^2 说明"数值从哪来":
//     f_x  = 2*a*x      ->  f_xx = 2*a
//     f_y  = 2*b*y      ->  f_yy = 2*b
//     f_zz = 0(曲面不含 z)
//     ∇²f  = 2*a + 2*b  (处处常数,与测量点无关)
// 展开行按符号给出 `∇²f = 2·a + 2·b + 0`(系数保持符号,不做数值合并),
// 摘要行才是代入当前 a/b 后的数字--这是本项目"先给算子公式,再给数值"
// 的既有展示契约.拖动 a/b 滑块时数值直接变成 2a + 2b;a=b=0 时曲面
// 退化成平面 z=0,拉普拉斯为 0(平面上没有弯曲,自然无"源/汇").
// 想看"数值随点变化"的例子,见 example/laplacian_harmonic.miko.
// =============================================================

// 可调参数:两个二次项系数 a/b,测量点 (px, py)
param a = 1 in [-2, 2, 0.1];
param b = 1 in [-2, 2, 0.1];
param px = 1 in [-3, 3, 0.1];
param py = 1 in [-3, 3, 0.1];

// 源曲面:抛物面 z = a*x^2 + b*y^2
surface s = a * x^2 + b * y^2 {
    range = [-3, 3, -3, 3];
    segments = 96;
}

// 拉普拉斯分析:在 (px, py) 处求 ∇²f,数值 = 2*a + 2*b
laplacian L = laplacian(s) at [px, py];

sphere ball = [0, 0, 0] {
    radius = 6;
    opacity = 0.5;
    segments = 64;
};

// 笛卡尔:给空间点,先沿 ∇f 投影到球面,再在投影点取 ∇²f
laplacian L1 = laplacian(ball) at [1, 2, 1];


param px0 = 1 in [-3, 3, 0.1];
param py0 = 1 in [-3, 3, 0.1];
param pz0 = 1 in [-3, 3, 0.1];
implicit shell = x^2 + y^2 + z^2 + 0.5 * z^3 - 36;
laplacian L2 = laplacian(shell) at [px0, py0, pz0];
