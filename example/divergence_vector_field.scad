// =============================================================
// 向量场的散度 div F = ∂P/∂x + ∂Q/∂y + ∂R/∂z
//
// 向量场 vector_field F = [P, Q, R] 的三个分量在编译期被符号引擎
// 逐项对 x/y/z 求偏导(见 derivative_rules.scad 的法则),散度分析
// 在测量点处把它们组合成标量:
//     divergence d = div(F) at [px, py, pz];
// 结果以数字形式打印在右侧"结果"列表;散度是"净流出量"的度量,
// 与测量点附近箭头的聚合程度对应:
//   div F > 0:该点是"源"(净流出);div F < 0:该点是"汇"(净流入);
//   div F = 0:处处无源(不可压缩 / 无散场).
//
// 本例给出两个对照场:
//   1) F_lin = [a*x, b*y, c*z] -- 线性源/汇场
//        div F_lin = a + b + c(处处常数)
//      三个方向同正(a=b=c=1)时箭头从原点向外扩散(源);
//      把 c 拖成负数后 z 方向内收,总散度随之减小.
//   2) F_rot = [-w*y, w*x, 0] -- 绕 z 轴的刚体旋转场
//        div F_rot = ∂(-w*y)/∂x + ∂(w*x)/∂y + ∂0/∂z = 0
//      永远无散,拖动 w 数值恒为 0.
//
// 两个场画在同一个盒子里会相互遮挡,建议先在"对象"面板隐藏其一
// (对象行的眼睛图标),再拖动滑块对照"结果"面板的数值.
// =============================================================

// 可调参数:源/汇强度 a/b/c,旋转角速度 w,测量点 (px, py, pz)
param a = 1 in [-2, 2, 0.1];
param b = 1 in [-2, 2, 0.1];
param c = 1 in [-2, 2, 0.1];
param w = 1 in [0.2, 4, 0.1];
param px = 1 in [-3, 3, 0.1];
param py = 1 in [-3, 3, 0.1];
param pz = 1 in [-3, 3, 0.1];

// 场 1:线性源/汇场,div = a + b + c
vector_field F_lin = [a * x, b * y, c * z] {
    range = [-4, 4, -4, 4, -4, 4];
    grid = [5, 5, 5];
    scale = 0.9;
};

// 场 2:刚体旋转场,div = 0
vector_field F_rot = [-w * y, w * x, 0] {
    range = [-4, 4, -4, 4, -4, 4];
    grid = [5, 5, 5];
    scale = 0.9;
};

// 散度分析:两个场在同一个测量点取值,结果面板给出两个标量
divergence d_lin = div(F_lin) at [px, py, pz];

divergence d_rot = div(F_rot) at [px, py, pz];
