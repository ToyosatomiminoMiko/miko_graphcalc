// =============================================================
// 地球与三星覆盖:3 颗卫星到底能覆盖到哪
//
// 先说结论:**3 颗卫星不可能覆盖整个地球**.
//
// 一颗卫星看到的地面是一顶"覆盖帽".设地球半径 R,轨道高度 h,地心距
// d = R + h,则 0° 仰角(几何地平)下帽子的地心张角
//     μ = arccos(R / d) < 90°
// 对任何有限高度都严格小于半球.而三顶小于半球的帽子盖不住整个球面:
// 用 3 个闭集覆盖球面 S²,必有一个含对径点(Lusternik–Schnirelmann),
// 但张角 < 90° 的帽装不下对径点(对径点相距 180°,帽的直径 < 180°).
//
// 能做到的**最好**安排就是本例:3 颗卫星在同一轨道面(赤道面)内相隔
// 120°.此时离最近卫星最远的点(两极)距离恰为 90°,而 3 点的覆盖半径
// 最小值就是 90°(与两颗对径卫星的最坏情况相同;三颗的好处是把未覆盖
// 区域压成两个极冠,而不是两条经向带).
//
// 未覆盖区是两个极冠,边界是起伏的闭合曲线:
//     卫星所在经线上,极冠边界到纬度 arccos(R / d)
//     相邻两星中间经线上,极冠边界到纬度 arccos(2R / d)   <- 更靠南
// 所以"保证覆盖 |纬度| <= arccos(2R/d)"是对所有经线都成立的说法.
//
//     h / km        覆盖帽张角 μ   保证覆盖纬度   极冠角半径
//     400   (LEO)   19.8°         -(三帽不相接)  -
//     20200 (GPS)   76.1°         ±61.3°         28.7°
//     35786 (GEO)   81.3°         ±72.4°         17.6°
//     120000        87.1°         ±84.2°          5.8°
//
// 两个临界点:h < R = 6371 km 时三顶帽子根本不相接(μ < 60°),赤道上
// 也有洞(赤道上离最近卫星最远的点距离恰为 60°);h -> ∞ 时 μ -> 90°,
// 极冠面积 -> 0 但永不为 0--"覆盖全球"只是 h -> ∞ 的极限.
// 以上都按 0° 仰角算;工程上留仰角余量 ε(常取 5°~10°)时
//     μ = 90° - ε - arcsin(R cos ε / d)
// 更小,极冠更大.
//
// 单位:1 单位 = 1000 km,地球取平均半径 6371 km = 6.371 单位.
// 视角:默认视口只框住地球,而卫星一定在框外(视口半高 7 单位,GEO 的地心距
// 是 42 单位)--覆盖圈画在地表,近地那几段弧在默认视角里就能看到;滚轮
// 缩小才看得到卫星与完整波束.拖动 h 看覆盖圈随高度扩大,极冠缩小(但不会
// 消失);把 h 拖到 6.371(一个地球半径)附近是三帽刚好相接的临界形态.
//
// 画法:每颗卫星一道"覆盖波束"圆锥,顶点在卫星,底沿落在地表,由构造
// 保证底沿正好是覆盖圈--底心距地心 R²/d,底半径 R·sqrt(1-(R/d)²),
// 母线于是与球面相切.这里**不用** `intersection` 求这条圈:圆锥面沿整条
// 圈与球面相切,是数值退化情形,求交核只认严格变号,给不出干净曲线.
// =============================================================

// 轨道高度(单位 1000 km;缺省 35.786 即地球同步轨道 GEO)
param h = 35.786 in [0.4, 120, 0.5];

// 地球:平均半径 6371 km
sphere Zemlya = [0, 0, 0] {
    radius = 6.371;
    color = "#3f7fd8";
    opacity = 0.5;
    segments = 64;
};

// 三颗卫星:同一轨道面(赤道面)内相隔 120°,方位角直接写成 2πk/3
point sputnik1 = [6.371 + h, 0, 0] {
    color = "#6dd5ff";
};

point sputnik2 = [
    (6.371 + h) * cos(2 * pi / 3),
    (6.371 + h) * sin(2 * pi / 3),
    0,
] {
    color = "#ff6b8a";
};

point sputnik3 = [
    (6.371 + h) * cos(4 * pi / 3),
    (6.371 + h) * sin(4 * pi / 3),
    0,
] {
    color = "#6bffb8";
};

// 圆锥局部轴是 +Y,几何中心在母线中点,所以把 +Y 转到方位角 α 用
// rotate([0, 0, α - pi/2]);配合 position 的 y = (d + R²/d)/2,
// 顶点正好落在卫星上,底心落在覆盖圈所在平面(距地心 R²/d)上.
transform beamAxis1 = rotate([0, 0, -pi / 2]);      // α = 0°
transform beamAxis2 = rotate([0, 0, pi / 6]);       // α = 120°
transform beamAxis3 = rotate([0, 0, 5 * pi / 6]);   // α = 240°

// 覆盖波束:底沿(圆锥的边界边)画出来就是该卫星的覆盖圈
cone beam1 = [0, ((6.371 + h) + 6.371 * 6.371 / (6.371 + h)) / 2, 0] {
    base = 6.371 * sqrt(1 - (6.371 / (6.371 + h)) ^ 2);
    height = (6.371 + h) - 6.371 * 6.371 / (6.371 + h);
    transform = beamAxis1;
    color = "#6dd5ff";
    opacity = 0.14;
    segments = 96;
};

cone beam2 = [0, ((6.371 + h) + 6.371 * 6.371 / (6.371 + h)) / 2, 0] {
    base = 6.371 * sqrt(1 - (6.371 / (6.371 + h)) ^ 2);
    height = (6.371 + h) - 6.371 * 6.371 / (6.371 + h);
    transform = beamAxis2;
    color = "#ff6b8a";
    opacity = 0.14;
    segments = 96;
};

cone beam3 = [0, ((6.371 + h) + 6.371 * 6.371 / (6.371 + h)) / 2, 0] {
    base = 6.371 * sqrt(1 - (6.371 / (6.371 + h)) ^ 2);
    height = (6.371 + h) - 6.371 * 6.371 / (6.371 + h);
    transform = beamAxis3;
    color = "#6bffb8";
    opacity = 0.14;
    segments = 96;
};
