// =============================================================
// 不定积分:原函数与"求导验算"
//
// 学习目标:看懂 `antiderivative 名称 = antiderivative(源对象 [, 变量]);`
//   怎么把一条曲线的表达式反过来积分,并把它当成普通曲线继续用.
// 前置:先看 `derivative_curve.miko`(知道求导对象长什么样).
// 操作:拖动参数 `a`,观察下面三条曲线哪条跟着动.
// 观察:
//   1) `F` 就是 `f` 的原函数:视口里 `F` 是一条新曲线,公式行写成
//      `y = ∫(f) dx + (常数)`;
//   2) 右下"原函数"子列表点开细节,最后一行是**回代验证**:
//      `d/dx(F) = f`--这是"原函数对不对"的唯一凭据;
//   3) 再对 `F` 求一次导(`derivative back = derivative(F);`),得到的曲线
//      与 `f` 完全重合,这就是微积分基本定理的图形版本.
// 思考:把 `constant` 改成 3,曲线会怎么动?为什么它仍是同一个原函数?
// =============================================================

// 被积函数:f(x) = a*x^2 + sin(x)
param a = 1 in [0.5, 3, 0.1];

curve f = a*x^2 + sin(x) {
    color = "#6dd5ff";
    range = [-4, 4];
    segments = 256;
}

// 原函数:F(x) = a*x^3/3 - cos(x) + C(这里 C 取 0)
// `range`/`segments` 缺省继承源对象,所以两条曲线定义域一致,便于对照.
antiderivative F = antiderivative(f);

// 对原函数再求导:应当与 `f` 重合(微积分基本定理)
derivative back = derivative(F);

// 点分析:在 x = 1 处比较 f 与其原函数的切线--原函数的切线斜率就是 f 的值.
gradient tangentAtOne = grad(F) at [1, 0] {
    show = [point, normal, tangent];
}
