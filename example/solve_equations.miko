// =============================================================
// 方程求解:一次 / 二次方程的分步推导
// =============================================================
//
// `solve 名称 = 左 = 右;` 在**编译期**求解(单变量,数值系数);联立写成
// `solve 名称 = { 方程1; 方程2; } [选项];`.解集与步骤进入底部求值对象列表的
// "求解"子列表;点条目行末的"过程",右栏过程页会先显示**题目**(待求解的方程 /
// 方程组),再逐行给出推导与依据徽章.
//
// 内核边界(刻意保守,不追求完整 CAS):
// - 单方程只支持一次 / 二次多项式;三次以上,分母含未知量,超越项(如 sin(x))
//   都明确报"无法求解",而不是给一个看起来像推导的东西;
// - 联立 v1:线性方程组走精确消元;非线性方程组改走数值路径(网格起点 + 阻尼
//   Newton),过程里如实标注"数值解"与搜索区间;超定 / 欠定 / 系数矩阵奇异
//   明确给能力边界理由;
// - 系数必须是数值:方程里的参数按当前滑块值代入,拖动参数会重新求解.
//   过程里"原式"后面会紧跟一步**参数取值**(如 `a=1`),后面每一步都写成代入
//   数值的形式--拖动 a 之后,这一行就是能直接看出系数变了的地方.
//
// 二次方程有两条推导路径:
// - 首项系数为 1 且判别式是完全平方 -> 因式分解 + 零积律(课本板书路径);
// - 其余 -> 判别式 + 求根公式;有理根给精确分式,无理根给根式 + 数值近似.

// 可调参数:系数 a
param a = 1 in [1, 3, 0.1];

// 抛物线 y = f(x):它的两个零点就是下面 S1 的两个根,
// 在三维视口里可以直接看到"解方程 = 找曲线与 x 轴的交点".
curve f = x^2 - 5*x + 6 {
    color = "#6dd5ff";
    range = [-1, 6];
    segments = 128;
}

// 1) 因式分解路径:x^2 - 5x + 6 = (x - 2)(x - 3)
solve S1 = x^2 - 5*x + 6 = 0;

// 2) 求根公式路径:a=1 时 x^2 - 2 = 0 -> x = ±√2(判别式 8 不是完全平方).
//    把上面的 a 拖到 2,方程变成 2x^2 - 2 = 0 -> x = ±1,重新编译后解集随之变化.
solve S2 = a*x^2 - 2 = 0;

// 3) 两边都有未知量:先移项合并同类项,再解一次方程
solve S3 = 2*x + 3 = x - 1;

// 4) 判别式小于 0:无实数解
solve S4 = x^2 + 1 = 0;

// 5) 联立方程组(线性):两条方程共享未知量 x, y -> 精确消元 + 回代.
//    过程页步骤:原式 -> 移项合并同类项 -> 加减消元 -> 回代求解.
solve S5 = { x + y = 3; x - y = 1; };

// 6) 联立方程组(非线性):圆与直线,精确路径解不了,内核落到**数值**路径.
//    range 给数值搜索区间(不给就用内核默认 [-10, 10]),过程页会如实写出
//    搜索区间并把结果标成"数值解" -- 数值搜索不保证不漏根.
solve S6 = { x^2 + y^2 = 1; x - y = 0; } { range = [-2, 2]; segments = 24; };
